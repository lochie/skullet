{
  "name": "skele-monorepo",
  "private": true,
  "packageManager": "pnpm@9.10.0",
  "type": "module",
  "scripts": {
    "install:all": "pnpm -r install",
    "watch": "pnpm --filter=skele dev",
    "dev": "pnpm run watch & pnpm run site:dev",
    "build": "pnpm --filter=skele build",
    "site:dev": "pnpm --filter=site dev",
    "site:build": "pnpm run build && node scripts/bundle-sizes.mjs && pnpm --filter=site build",
    "example:react": "pnpm --filter=react-example dev",
    "example:svelte": "pnpm --filter=svelte-example dev",
    "example:svelte-ssr": "pnpm --filter=svelte-ssr-example dev",
    "example:typescript": "pnpm --filter=typescript-example dev",
    "example:vue": "pnpm --filter=vue-example dev",
    "lint": "pnpm --filter=skele lint && pnpm --filter=site lint",
    "lint:fix": "pnpm --filter=skele lint:fix && pnpm --filter=site lint:fix",
    "pre-commit": "pnpm run --filter=skele pre-commit",
    "version": "changeset version && git add --all",
    "test": "pnpm --filter=skele test",
    "typecheck": "pnpm --filter=skele typecheck",
    "release": "pnpm run typecheck && pnpm run test && pnpm build && changeset publish && git push --follow-tags"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@commitlint/cli": "^17.8.0",
    "@commitlint/config-conventional": "^17.8.0",
    "lint-staged": "^15.0.2"
  }
}
